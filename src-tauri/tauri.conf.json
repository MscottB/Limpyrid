{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limpyrid",
  "version": "0.1.0",
  "identifier": "com.limpyrid.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Limpyrid",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Pergamio",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwQjI2NUUyMUNCMkY2N0UKUldSKzlySWM0bVd5NEIyaEkwT2w0eFFxRVdxUkw5ekx5OENIbXhuU29uUG8vS2phRVIvR3JGc2oK",
      "endpoints": [
        "https://github.com/MscottB/Limpyrid/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
